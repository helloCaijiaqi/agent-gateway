# agent-gateway 环境变量模板（QQ 单平台最小集）
#
# 用法：复制为 .env（start-gateway.bat 首次运行会自动复制），按需改值。
# 真实环境变量永远优先于 .env —— 想临时覆盖某项时直接在 shell 里 set。
#
# ⚠ 密钥不进 .env。三类密钥的正确落位见文件末尾「密钥落位」注释块。

# ── 运行模式 ──────────────────────────────────────────────────────────────
# off（默认，仅控制台/健康检查）| shadow（灰度，只记录不执行）| on（完整运行）
# 2026-11-16 起消息面运行时常驻装配、mode 为请求期活读门禁：控制台侧边栏开关
# （POST /v1/console/mode）切换即时生效零重启，并原子写回本文件保持重启后不变；
# 切 on 的 fail-closed 校验（消费端非空 + 编排键有主）在切换点执行。
# shadow 不支持在线切换（改 env 后重启）。
GATEWAY_MODE=on

# HTTP/WS 监听地址与端口（默认 127.0.0.1:7190；非回环地址会打 TLS 告警）
GATEWAY_HOST=127.0.0.1
GATEWAY_PORT=7190

# 状态目录固定在 <仓库>/state/gateway（登记 services/、编排 pipelines.json、
# secrets/ 都在这下面），无环境变量可改。

# ── DSH（DeepSeekHarness，思考引擎）──────────────────────────────────────
# fail-closed：preset 必须在 DSH 可用清单里，否则拒绝建会话（绝不回退 DSH 默认）
GATEWAY_DSH_BASE_URL=http://127.0.0.1:3080
# DSH 侧访问令牌（DSH 未开鉴权可留空）
# GATEWAY_DSH_TOKEN=
GATEWAY_PRESET=qq-chat-v2
GATEWAY_MODEL=deepseek-flash

# ── 消费端身份（唯一的注册方式 = 登记目录）──────────────────────────────────
# 消费端只认 state/gateway/services/<id>.json（kind=consumer），没有环境变量入口：
# 旧的 GATEWAY_ADAPTER_ID / GATEWAY_ADAPTER_PLATFORM / GATEWAY_SECRET 与
# adapters.json 均已退役——读到任意一项即启动失败并给出迁移步骤。
# 生成一份 consumer 登记：
#   npm run secrets:gen                      # 默认 id = svc-<hash>，产出密钥 + 交接文件
#   # 再写 state/gateway/services/svc-<hash>.json（kind/transport/platform/url/secretFile）
# 多账号（如 QQ 多开）= 多份登记，各自 svc-<hash> id 与密钥，编排键即该 id。

# ── 会话缓冲与记忆 save（session-save，tool.call chat_memory_save）────────────
# off（默认）| on。会话缓冲上移网关：消息逐条持久化到 state/gateway/session-buffer/，
# 空闲超时/触顶分段/关停补发时经 tool.call 整段落地（落地时机完全由网关裁决）。
GATEWAY_MEMORY_SAVE=on
# 目标服务选路（selectMemoryService 三级）：留空 = 自动选「唯一声明
# memoryService:true 的登记服务」（多声明取字典序首个 + 一次性告警）；
# 有多个候选且要指定时填登记 id。
# GATEWAY_MEMORY_SERVICE=
# 空闲超时（1s–24h，默认 1h）：会话静默该时长后整段 save。
# GATEWAY_MEMORY_SAVE_IDLE_MS=3600000
# 触顶分段阈值：消息条数（默认 200）/ 缓冲文本总字数（默认 20000）。
# GATEWAY_MEMORY_SAVE_MAX_MESSAGES=200
# GATEWAY_MEMORY_SAVE_MAX_CHARS=20000

# ── 工具面（DSH 会话里的工具）─────────────────────────────────────────────
# on 需要 mcp-bus 共享密钥：<stateDir>/mcp-bus.secret（>=16 字符，文件单源）。
# env 通道（GATEWAY_MCP_BUS_TOKEN 及旧名 GATEWAY_MCP_TOKEN*）已退役——读到即拒载。
# 首跑由 start-gateway.bat / npm run env:init 生成；mcp-bus 薄壳经 DSH 条目的
# --token-file 读同一份文件。
GATEWAY_TOOLS=on
# sensitive 动作（如 set_wake）默认不进清单；确需开启显式设 on
# GATEWAY_TOOL_SENSITIVE=off

# ── 控制台 ────────────────────────────────────────────────────────────────
# 凭据文件单源：<stateDir>/operator-token（缺失时启动自动生成并持久化，
# init-env 生成时会明文打印一次供登录）。env 通道 GATEWAY_OPERATOR_TOKEN
# 已退役——读到即拒载。

# ── .env 装载自身 ─────────────────────────────────────────────────────────
# .env 文件路径覆盖（默认包根 .env）；本项只在真实环境变量里设才有意义
# GATEWAY_ENV_FILE=

# ══════════════════════════════════════════════════════════════════════════
# 密钥落位（三类，都不放本文件）
#
# 1. 消费端密钥（bridge ↔ 网关 HMAC 验签）：
#      npm run secrets:gen                     # 默认 id = svc-<hash>
#    → 写入 state/gateway/secrets/svc-<hash>.secret，并生成交接文件
#      state/gateway/handoff/svc-<hash>.gateway.json；
#      登记文件 state/gateway/services/svc-<hash>.json 里填
#      "secretFile": "secrets/svc-<hash>.secret"，
#      桥接侧把交接文件复制成自己的 gateway.json（不再改 config.json）。
#
# 2. 登记服务密钥（memory-mcp / rolecard-mcp 的 tool.call 验签，
#    也是会话缓冲 save 用的那把——不再有单独的 memory ingest token）：
#      控制台 POST /v1/console/services 注册：secret 可留空（网关自动生成，
#      回执一次性明文回显），也可显式提交或用 secretEnv
#    → 网关自动落 state/gateway/secrets/<id>.secret（0600），并生成
#      state/gateway/handoff/<id>.gateway.json；服务侧只读复制过去的 gateway.json。
#
# 3. 控制台 operator token / mcp-bus token：文件单源，都由 start-gateway.bat
#      首跑 / npm run env:init 生成维护，>=16 字符随机串：
#        <stateDir>/operator-token    控制台登录（x-operator-token / Cookie 签名）
#        <stateDir>/mcp-bus.secret    网关 ↔ mcp-bus 薄壳 HMAC（DSH --token-file 同读）
#      .env 不承载任何 token；残留的 GATEWAY_OPERATOR_TOKEN / GATEWAY_MCP_BUS_TOKEN
#      会让启动 fail-closed（env:init 会就地清理）。
# ══════════════════════════════════════════════════════════════════════════
